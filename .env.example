# Application Environment
APP_ENV=development

# Database Configuration (Replace with your PostgreSQL credentials)
DATABASE_URL=postgresql://your_db_username:your_db_password@localhost:5432/your_db_name

# Security & Authentication (JWT)
SECRET_KEY=generate_your_secure_secret_key_here_using_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# LLM & AI Configuration
GROQ_API_KEY=your_groq_api_key_here

# Embeddings & Document Ingestion
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
MAX_UPLOAD_SIZE_MB=20
